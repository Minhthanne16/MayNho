# Cấu hình mẫu môi trường local (KHÔNG chứa secret thật)
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=5000

ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=maynho_dev;Username=maynho_user;Password=maynho_dev_password
ConnectionStrings__AppDb=Host=localhost;Port=5433;Database=maynho_dev;Username=maynho_user;Password=maynho_dev_password

App__PublicUrl=http://localhost:5000

# Auth Google (thông tin đăng ký cục bộ hoặc staging)
Auth__Google__ClientId=
Auth__Google__ClientSecret=

# Email Provider
Email__Provider=Mailpit
Email__Mailpit__Host=localhost
Email__Mailpit__Port=1025
Email__FromAddress=nhacviec@notify.maynho.local
Email__FromName=Mây Nhỏ
Email__ResendApiKey=
Email__ResendWebhookSecret=
